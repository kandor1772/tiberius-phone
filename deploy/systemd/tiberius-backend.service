[Unit]
Description=Tiberius always-on backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiberius
WorkingDirectory=/opt/tiberius-phone
Environment=HOST=127.0.0.1
Environment=PORT=8776
Environment=TIBERIUS_STATE_PATH=/var/lib/tiberius/tiberius-backend-state.json
ExecStart=/usr/bin/python3 /opt/tiberius-phone/multiplayer_relay.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
