FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0
ENV PORT=8776
ENV TIBERIUS_STATE_PATH=/data/tiberius-backend-state.json

WORKDIR /app
COPY multiplayer_relay.py /app/multiplayer_relay.py

RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8776

CMD ["python", "/app/multiplayer_relay.py"]
